# ============================================================
# Fall Detection — Environment Variables
# ============================================================
# Salin file ini ke .env dan isi nilainya.
#   cp .env.example .env
# ============================================================

# ---- General -----------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ---- Backend Server ----------------------------------------
HOST=0.0.0.0
PORT=8000

# ---- Database ----------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./fall_detection.db

# ---- YOLOv8 Model -----------------------------------------
# Path ke file best.pt hasil training
# MODEL_PATH=./ml/models/fall_detection/weights/best.pt
CONFIDENCE_THRESHOLD=0.5

# ---- Fall Detection Thresholds -----------------------------
FALL_DURATION_THRESHOLD=10.0
POSSIBLE_FALL_THRESHOLD=2.0

# ---- Camera Source -----------------------------------------
# "0" untuk webcam lokal, atau URL RTSP:
# CAMERA_SOURCE=rtsp://admin:password@192.168.1.100:554/stream
CAMERA_SOURCE=0
CAMERA_FPS=15

# ---- Telegram Notification --------------------------------
# Buat bot via @BotFather, dapatkan token.
# Chat ID bisa didapat via @userinfobot atau API getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- CORS --------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
