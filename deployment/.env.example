# ============================================================
# FallDetect — variabel lingkungan untuk Docker
# ============================================================
# Salin menjadi .env di folder yang sama (tidak ikut git), lalu isi:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
# Untuk menjalankan tanpa Docker, pakai backend/.env.example.
# ============================================================

# ---- Akun login (wajib) ------------------------------------
# Satu akun tim, dibuat otomatis saat backend menyala. Tanpa keduanya,
# dashboard tidak bisa dibuka karena tidak ada akun untuk login.
DEMO_USERNAME=
DEMO_PASSWORD=

# ---- Kamera pertama ----------------------------------------
# Hanya dipakai saat database masih kosong (start pertama). Kamera lain
# ditambahkan dari halaman Daftar Kamera di dashboard.
# Webcam laptop tidak bisa dibuka dari dalam Docker di Windows. Pilih salah satu:
#   - video di folder deployment/video/, misalnya /app/video/contoh.mp4
#     (video diputar ulang dari awal setiap kali habis);
#   - kamera HP lewat aplikasi IP Webcam, misalnya http://192.168.1.20:8080/video
CAMERA_SOURCE=/app/video/contoh.mp4
CAMERA_ROTATE=0

# ---- Deteksi -----------------------------------------------
# Nilai demo, sama dengan run-backend.bat. Setelah start pertama, ambang diatur
# dari halaman Pengaturan dan tersimpan di database.
FALL_DURATION_THRESHOLD=3
ALERT_COOLDOWN_SEC=10

# ---- Telegram (opsional) -----------------------------------
# Token dari @BotFather dan chat ID grup. Kosong = notifikasi Telegram mati.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
