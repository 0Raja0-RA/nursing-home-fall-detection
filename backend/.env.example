# ============================================================
# Fall Detection — Environment Variables (backend)
# ============================================================
# Salin file ini jadi backend/.env lalu isi nilainya:
#   cp backend/.env.example backend/.env
#
# backend/.env TIDAK ikut ke git (lihat .gitignore). Jangan pernah
# menempelkan isinya ke chat, issue, atau screenshot.
# ============================================================

# ---- Akun demo ---------------------------------------------
# Satu akun untuk tim, dibuat otomatis setiap backend menyala (peran pengelola).
# Tanpa dua baris ini tidak ada yang bisa masuk ke dashboard. Isi di sini, jangan
# di kode: dashboard pameran bisa dibuka dari internet lewat tunnel.
# Mengganti sandi cukup di sini; backend menyamakannya saat dijalankan ulang.
DEMO_USERNAME=
DEMO_PASSWORD=
# Nama yang tampil saat menekan "Saya ke sana".
# DEMO_NAME=Tim FallDetect

# ---- Telegram ----------------------------------------------
# 1. Buat bot lewat @BotFather, lalu salin tokennya ke sini.
#    Nama variabelnya harus persis TELEGRAM_BOT_TOKEN.
# 2. Chat tujuan harus menyapa bot lebih dulu — bot Telegram tidak
#    bisa mengirim pesan ke pihak yang belum pernah menghubunginya.
#    Untuk grup, kirim /start@NamaBot_bot di dalam grup itu.
# 3. Ambil chat_id-nya dengan:
#       .venv\Scripts\python.exe tools\get_chat_id.py
#    lalu simpan pilihannya:
#       .venv\Scripts\python.exe tools\get_chat_id.py --simpan <chat_id>
#
# chat_id grup bernilai negatif (mis. -1001234567890); chat perorangan positif.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alamat dashboard untuk tombol "Buka dashboard" di pesan alarm, mis.
# http://192.168.1.10:5173/dashboard. Kosongkan kalau HP perawat tidak bisa membukanya.
# DASHBOARD_URL=
# Kamera dikabarkan terputus ke grup setelah sekian detik tanpa gambar.
# CAMERA_OFFLINE_NOTIFY_SEC=30

# ---- Klip kejadian ------------------------------------------
# Klip beberapa detik sebelum dan sesudah alarm, untuk Riwayat Insiden. Dihapus
# otomatis setelah sekian hari; 0 = tidak merekam klip dan menghapus yang ada.
# Klip tidak pernah dikirim ke Telegram.
# KLIP_MASA_SIMPAN_HARI=7
# KLIP_DIR=klip

# ---- Model -------------------------------------------------
# Bawaannya sudah menunjuk ml/models/fall_detection/weights/best.pt,
# jadi baris ini hanya perlu diisi kalau file modelnya ditaruh di tempat lain.
# MODEL_PATH=

# ---- Kamera ------------------------------------------------
# CATATAN: daftar kamera disimpan di database dan diatur lewat halaman
# "Daftar Kamera" di dashboard. Dua baris di bawah HANYA dipakai untuk
# membuat kamera pertama saat database masih kosong.
# CAMERA_SOURCE=0
# CAMERA_ROTATE=0

# ---- Ambang deteksi ----------------------------------------
# CONFIDENCE_THRESHOLD=0.5
# FALL_DURATION_THRESHOLD=10
# POSSIBLE_FALL_THRESHOLD=2
# ALERT_COOLDOWN_SEC=60
# MAX_CAMERAS=4
