# ============================================================
# Fall Detection — Environment Variables (backend)
# ============================================================
# Salin file ini jadi backend/.env lalu isi nilainya:
#   cp backend/.env.example backend/.env
#
# backend/.env TIDAK ikut ke git (lihat .gitignore). Jangan pernah
# menempelkan isinya ke chat, issue, atau screenshot.
# ============================================================

# ---- Telegram ----------------------------------------------
# 1. Buat bot lewat @BotFather, lalu salin tokennya ke sini.
#    Nama variabelnya harus persis TELEGRAM_BOT_TOKEN.
# 2. Chat tujuan harus menyapa bot lebih dulu — bot Telegram tidak
#    bisa mengirim pesan ke pihak yang belum pernah menghubunginya.
#    Untuk grup, kirim /start@NamaBot_bot di dalam grup itu.
# 3. Ambil chat_id-nya dengan:
#       .venv\Scripts\python.exe tools\get_chat_id.py
#    lalu simpan pilihannya:
#       .venv\Scripts\python.exe tools\get_chat_id.py --simpan <chat_id>
#
# chat_id grup bernilai negatif (mis. -1001234567890); chat perorangan positif.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Model -------------------------------------------------
# Bawaannya sudah menunjuk ml/models/fall_detection/weights/best.pt,
# jadi baris ini hanya perlu diisi kalau file modelnya ditaruh di tempat lain.
# MODEL_PATH=

# ---- Kamera ------------------------------------------------
# CATATAN: daftar kamera disimpan di database dan diatur lewat halaman
# "Kelola Kamera" di dashboard. Dua baris di bawah HANYA dipakai untuk
# membuat kamera pertama saat database masih kosong.
# CAMERA_SOURCE=0
# CAMERA_ROTATE=0

# ---- Ambang deteksi ----------------------------------------
# CONFIDENCE_THRESHOLD=0.5
# FALL_DURATION_THRESHOLD=10
# POSSIBLE_FALL_THRESHOLD=2
# ALERT_COOLDOWN_SEC=60
# MAX_CAMERAS=4
